{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/main/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "io.dbx.api-studio",
  "name": "API Studio",
  "version": "0.1.0",
  "publisher": "runstone",
  "description": "Build, send, debug and manage API requests in DBX.",
  "icon": "assets/plugin.svg",
  "source": "https://github.com/Abeautifulsnow/dbx-plugin-api-studio",
  "homepage": "https://github.com/Abeautifulsnow/dbx-plugin-api-studio",
  "engines": {
    "dbx": ">=0.5.68",
    "host_api": "1"
  },
  "permissions": [],
  "entrypoints": {
    "backend": {
      "executable": "bin/dbx-plugin-dbx-plugin-api-studio"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "workbench",
      "id": "io.dbx.api-studio.workbench",
      "label": "API Studio Workbench",
      "description": "Compose, send and inspect HTTP requests.",
      "icon": "assets/plugin.svg"
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "API Studio",
      "description": "在 DBX 中构建、发送、调试和管理 API 请求。",
      "contributions": {
        "io.dbx.api-studio.workbench": {
          "label": "API Studio 工作台",
          "description": "组合、发送并检查 HTTP 请求。"
        }
      }
    }
  }
}
