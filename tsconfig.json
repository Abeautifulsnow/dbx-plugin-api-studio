{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["svelte"]
  },
  "include": ["frontend/src/**/*.ts", "frontend/src/**/*.svelte", "vite.config.ts"]
}
